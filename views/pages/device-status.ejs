<%- include('../partials/header') %>
<%- include('../partials/sidebar', { active: 'device' }) %>

<main class="main">
  <%- include('../partials/topbar') %>

  <section class="content">
    <div class="page-heading">
      <div>
        <h1>ESP32 Device & Hardware Integration</h1>
        <p>Microcontroller telemetry, hardware communication contracts, interactive API console, and flashable firmware.</p>
      </div>
      <div class="heading-actions">
        <button class="btn btn-emerald" onclick="pingDevice()">⚡ Ping Node</button>
        <button class="btn btn-outline" onclick="downloadArduinoSketch()">⇩ Download .ino Sketch</button>
      </div>
    </div>

    <!-- Device Telemetry Grid -->
    <div class="device-grid">
      <section class="card device-hero-card">
        <div class="device-orb-wrap">
          <div class="device-orb">
            <span class="orb-icon">⚡</span>
          </div>
          <span class="orb-ping-ring"></span>
        </div>
        <h2><%= device.id %></h2>
        <span class="online-label">
          <i class="status-pulse"></i> <%= device.online ? 'Online & Active' : 'Offline' %>
        </span>
        <div class="device-mode-badge"><%= device.mode %></div>
        <p class="text-muted" style="margin-top:12px; font-size:12px;">ESP32-WROOM-32 IoT Microcontroller</p>
      </section>

      <section class="card device-info-card">
        <div class="card-header">
          <div class="card-title">
            <span>📡</span>
            <b>Network & Telemetry Stats</b>
          </div>
          <span class="badge badge-subtle">Real-Time Sync</span>
        </div>
        <div class="device-stats-list">
          <div class="info-row">
            <span>Wi-Fi Network (SSID)</span>
            <b><%= device.wifi %></b>
          </div>
          <div class="info-row">
            <span>Node IP Address</span>
            <code><%= device.ip %></code>
          </div>
          <div class="info-row">
            <span>System Uptime</span>
            <b id="deviceUptimeVal"><%= device.uptimeFormatted %></b>
          </div>
          <div class="info-row">
            <span>Total Sensor Packets</span>
            <b id="devicePacketVal"><%= device.packetsReceived %> packets</b>
          </div>
          <div class="info-row">
            <span>Last Packet Received</span>
            <small id="deviceLastSeenVal"><%= new Date(device.lastSeen).toLocaleString('en-IN') %></small>
          </div>
          <div class="info-row">
            <span>Ingestion Endpoint</span>
            <code>POST /api/sensor-data</code>
          </div>
        </div>
      </section>
    </div>

    <!-- Interactive API Tester Console -->
    <section class="card api-tester-card">
      <div class="card-header">
        <div class="card-title">
          <span>🧪</span>
          <b>Interactive Hardware API Test Console</b>
        </div>
        <span class="badge badge-emerald">POST /api/sensor-data</span>
      </div>
      <p class="text-muted" style="margin-bottom:14px; font-size:12px;">Test the exact HTTP endpoint that the ESP32 microcontroller uses to transmit sensor data packets to this server.</p>

      <div class="api-tester-layout">
        <form id="apiTestForm" onsubmit="sendApiTestPayload(event)">
          <div class="form-grid">
            <div class="form-group">
              <label>Food Type</label>
              <select id="apiFoodType" name="foodType" class="form-control">
                <% (foods || []).forEach(f => { %>
                  <option value="<%= f.key %>"><%= f.icon %> <%= f.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="form-group">
              <label>pH Sensor Value</label>
              <input type="number" id="apiPh" name="ph" step="0.01" value="6.62" class="form-control" required>
            </div>
            <div class="form-group">
              <label>MQ-135 Gas (ppm)</label>
              <input type="number" id="apiGas" name="gas" value="115" class="form-control" required>
            </div>
            <div class="form-group">
              <label>Temperature (°C)</label>
              <input type="number" id="apiTemp" name="temperature" step="0.1" value="6.1" class="form-control" required>
            </div>
            <div class="form-group">
              <label>Humidity (%)</label>
              <input type="number" id="apiHumidity" name="humidity" value="64" class="form-control" required>
            </div>
            <div class="form-group">
              <label>TDS Solids</label>
              <input type="number" id="apiTds" name="tds" step="0.1" value="4.9" class="form-control">
            </div>
            <div class="form-group">
              <label>Appearance / Color</label>
              <input type="text" id="apiColor" name="color" value="Normal" class="form-control">
            </div>
            <div class="form-group">
              <label>Device Source Tag</label>
              <input type="text" id="apiSource" name="source" value="ESP32_HARDWARE_TEST" class="form-control">
            </div>
          </div>
          <button type="submit" class="btn btn-primary" style="margin-top:12px;">🚀 Send Test Packet</button>
        </form>

        <div class="api-response-box">
          <div class="response-header">
            <span>HTTP RESPONSE CONSOLE</span>
            <span class="response-badge" id="apiResponseBadge">Ready</span>
          </div>
          <pre id="apiResponseJson">// Awaiting payload transmission...</pre>
        </div>
      </div>
    </section>

    <!-- ESP32 Pinout Wiring Guide -->
    <section class="card pinout-card">
      <div class="card-header">
        <div class="card-title">
          <span>🔌</span>
          <b>ESP32 Sensor Pinout & Wiring Specifications</b>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Sensor Module</th>
              <th>Physical Parameter</th>
              <th>ESP32 GPIO Pin</th>
              <th>Signal Type</th>
              <th>Operating Voltage</th>
              <th>Wiring Notes</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><b>Analog pH Sensor Kit</b></td>
              <td>Acidity / Alkalinity (pH)</td>
              <td><code>GPIO 34 (ADC1_CH6)</code></td>
              <td>Analog Voltage (0 – 3.3V)</td>
              <td>5.0V / 3.3V</td>
              <td>Connect analog out to GPIO34. Requires 2-point buffer calibration.</td>
            </tr>
            <tr>
              <td><b>MQ-135 Gas Sensor</b></td>
              <td>Ammonia, Sulfides, Alcohol, CO2</td>
              <td><code>GPIO 35 (ADC1_CH7)</code></td>
              <td>Analog Voltage</td>
              <td>5.0V (VCC)</td>
              <td>Requires 24h preheat burn-in for accurate ppm baseline reading.</td>
            </tr>
            <tr>
              <td><b>DS18B20 / DHT11</b></td>
              <td>Temperature & Ambient Humidity</td>
              <td><code>GPIO 4</code></td>
              <td>1-Wire Digital Signal</td>
              <td>3.3V</td>
              <td>Include 4.7kΩ pull-up resistor between VCC and Data line.</td>
            </tr>
            <tr>
              <td><b>Analog TDS Sensor</b></td>
              <td>Total Dissolved Solids (Liquids)</td>
              <td><code>GPIO 32 (ADC1_CH4)</code></td>
              <td>Analog Voltage</td>
              <td>3.3V – 5.5V</td>
              <td>Submerge probe in liquid sample. Waterproof probe recommended.</td>
            </tr>
            <tr>
              <td><b>Active Buzzer / LED</b></td>
              <td>Local Spoilage Alarm Indicator</td>
              <td><code>GPIO 18</code></td>
              <td>Digital Output (PWM)</td>
              <td>3.3V</td>
              <td>Sounds alarm frequency when server returns SPOILED verdict.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <!-- Flashable ESP32 Arduino Sketch -->
    <section class="card arduino-code-card">
      <div class="card-header">
        <div class="card-title">
          <span>⚡</span>
          <b>Complete ESP32 Arduino (.ino) Firmware Sketch</b>
        </div>
        <div class="arduino-actions">
          <button class="btn btn-sm btn-outline" onclick="copyArduinoCode()">📋 Copy Firmware Code</button>
          <button class="btn btn-sm btn-primary" onclick="downloadArduinoSketch()">⇩ Download .ino File</button>
        </div>
      </div>
      <p class="text-muted" style="margin-bottom:12px; font-size:12px;">Flash this sketch directly to your ESP32 board using Arduino IDE. Update your Wi-Fi SSID and PC IP address before uploading.</p>
      <pre class="code-block" id="arduinoCodeBlock"><code>/*
 * FoodGuard - Smart Food Quality Detection System
 * ESP32 Microcontroller Firmware
 * Final Year Engineering Project
 */

#include &lt;WiFi.h&gt;
#include &lt;HTTPClient.h&gt;
#include &lt;ArduinoJson.h&gt;

// --- Wi-Fi Credentials ---
const char* ssid = "<%= device.wifi %>";
const char* password = "YOUR_WIFI_PASSWORD";

// --- FoodGuard Server Address ---
// Replace with your laptop/PC local IP (e.g. http://192.168.1.100:8080)
const char* serverUrl = "http://192.168.4.2:8080/api/sensor-data";

// --- Pin Definitions ---
const int PIN_PH = 34;       // Analog pH probe
const int PIN_MQ135 = 35;    // MQ-135 Gas sensor analog out
const int PIN_TDS = 32;      // Analog TDS sensor
const int PIN_BUZZER = 18;   // Alarm buzzer

void setup() {
  Serial.begin(115200);
  pinMode(PIN_BUZZER, OUTPUT);
  digitalWrite(PIN_BUZZER, LOW);

  Serial.println("\nConnecting to Wi-Fi...");
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }
  Serial.println("\nConnected! IP Address: ");
  Serial.println(WiFi.localIP());
}

void loop() {
  if (WiFi.status() == WL_CONNECTED) {
    // 1. Read Analog Sensors
    int rawPh = analogRead(PIN_PH);
    float voltagePh = rawPh * (3.3 / 4095.0);
    float phValue = 3.5 * voltagePh; // Calibrated formula

    int rawGas = analogRead(PIN_MQ135);
    int gasPpm = map(rawGas, 0, 4095, 30, 450);

    int rawTds = analogRead(PIN_TDS);
    float tdsValue = (rawTds * (3.3 / 4095.0)) * 2.5;

    float temperature = 5.8; // From DS18B20 sensor
    int humidity = 62;       // From DHT11 sensor

    // 2. Build JSON Payload
    StaticJsonDocument&lt;256&gt; doc;
    doc["foodType"] = "milk";
    doc["ph"] = phValue;
    doc["gas"] = gasPpm;
    doc["temperature"] = temperature;
    doc["humidity"] = humidity;
    doc["tds"] = tdsValue;
    doc["color"] = "Normal";
    doc["wifi"] = WiFi.SSID();
    doc["ip"] = WiFi.localIP().toString();

    String requestBody;
    serializeJson(doc, requestBody);

    // 3. Send HTTP POST
    HTTPClient http;
    http.begin(serverUrl);
    http.addHeader("Content-Type", "application/json");

    int httpCode = http.POST(requestBody);
    if (httpCode > 0) {
      String response = http.getString();
      Serial.printf("Server Response (%d): %s\n", httpCode, response.c_str());

      // Sound buzzer if server flagged spoilage
      if (response.indexOf("SPOILED") != -1) {
        digitalWrite(PIN_BUZZER, HIGH);
        delay(800);
        digitalWrite(PIN_BUZZER, LOW);
      }
    } else {
      Serial.printf("HTTP Error: %s\n", http.errorToString(httpCode).c_str());
    }
    http.end();
  }

  // Transmit reading every 10 seconds
  delay(10000);
}
</code></pre>
    </section>
  </section>
</main>

<%- include('../partials/footer') %>
