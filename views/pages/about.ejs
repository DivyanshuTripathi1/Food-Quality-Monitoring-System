        </div>
        <div class="dev-details">
          <span class="dev-badge-role">System Architect & Full-Stack</span>
          <h3 class="dev-name">Divyanshu Tripathi</h3>
          <p class="dev-role">Lead Full-Stack Developer</p>
          <p class="dev-bio">
            Architected the complete MVC framework, Express REST APIs, multi-parameter food quality evaluation engine, 
            real-time telemetry streaming, Chart.js analytics, camera inspection module, and responsive modern UI design system.
          </p>
          <div class="dev-skills">
            <span class="skill-tag">Full-Stack Web</span>
            <span class="skill-tag">Node.js / Express</span>
            <span class="skill-tag">IoT Architecture</span>
            <span class="skill-tag">Evaluation Algorithms</span>
            <span class="skill-tag">UI/UX Design</span>
          </div>
        </div>
      </section>

      <!-- Developer 2: Pranjal Shahi -->
      <section class="card dev-card">
        <div class="dev-photo-wrap">
