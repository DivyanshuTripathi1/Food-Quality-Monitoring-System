<%- include('../partials/header') %>
<%- include('../partials/sidebar', { active: 'about' }) %>

<main class="main">
  <%- include('../partials/topbar') %>

  <section class="content">
    <!-- Page Heading -->
    <div class="page-heading">
      <div>
        <h1>About FoodGuard & Engineering Team</h1>
        <p>Smart Multi-Parameter Food Quality Detection System · Final Year Engineering Project</p>
      </div>
      <div class="heading-actions">
        <a href="/" class="btn btn-primary">Open Dashboard →</a>
      </div>
    </div>

    <!-- Project Mission Hero -->
    <div class="about-hero-card">
      <div class="about-hero-text">
        <span class="badge badge-emerald" style="margin-bottom:12px; display:inline-block;">Final Year Engineering Capstone</span>
        <h2>Revolutionizing Food Safety with IoT & Multi-Sensor Telemetry</h2>
        <p>
          FoodGuard is an advanced, automated food quality assessment and spoilage detection platform designed to eliminate reliance on subjective sensory checks. 
          By interfacing precision physicochemical sensors (analog pH, MQ-135 volatile organic gas detector, cold-chain temperature, humidity, and TDS solids) with an ESP32 microcontroller, 
          FoodGuard delivers real-time quality score verdicts, instant contamination alerts, and historical safety auditing.
        </p>
        <div class="hero-highlights">
          <div class="highlight-chip">⚡ Real-Time IoT Telemetry</div>
          <div class="highlight-chip">🔬 Multi-Parameter Rule Engine</div>
          <div class="highlight-chip">☁ MQ-135 Volatile Gas Sensing</div>
          <div class="highlight-chip">📷 Optical Sample Inspection</div>
        </div>
      </div>
    </div>

    <!-- Lead Developers Section -->
    <div class="section-title-wrap">
      <span class="section-badge">CORE DEVELOPERS</span>
      <h2>System Architects & Lead Engineers</h2>
      <p class="text-muted">The core software and hardware developers behind the FoodGuard platform architecture.</p>
    </div>

    <div class="developers-grid">
      <!-- Developer 1: Divyanshu Tripathi -->
      <section class="card dev-card">
        <div class="dev-photo-wrap">
          <img src="/images/divyanshu.jpg" alt="Divyanshu Tripathi" class="dev-photo" />
